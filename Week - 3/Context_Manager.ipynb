   "source": [
    "with open(\"cities.txt\", \"w\") as write_file, open(\"cities.txt\", \"r\") as read_file:\n",
    "    write_file.write(\"Tokyo\\n Paris\\n New York\\n Sydney\\n\")\n",
    "    count = 0\n",
    "    for line in read_file:\n",
    "        count += 1\n",
    "    print(f\"{count} cities saved\")"
   ]
