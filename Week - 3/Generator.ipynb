   "source": [
    "def topten():\n",
    "    n = 1\n",
    "\n",
    "    while n <= 10:\n",
    "        sq = n*n\n",
    "        yield sq\n",
    "        n += 1\n",
    "\n",
    "values = topten()\n",
    "\n",
    "for i in values:\n",
    "    print(i)"
